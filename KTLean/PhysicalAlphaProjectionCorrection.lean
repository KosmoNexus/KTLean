/-!
# The 8D-to-4D Alpha Projection Correction

## Formal status

**Level 2 - Exact symbolic derivation of the corrected alpha expression
from previously differentiated KT constants and projection data.**

## Developmental predecessor

`PhysicalAlphaInvariant`

The preceding module proves the exact substrate invariant

    alphaInverseMagnitude = 137
    alphaMagnitude        = 1 / 137.

That integer is the usable reversible channel capacity of the
eight-dimensional carrier before the full projection correction is
applied.

The refined Kosmoplex expression introduces four geometrically named
contributions:

1. rotational phase-space correction

       1 / (8 pi);

2. Shannon-state memory cost

       x(n) =
         log n / (2 * 137)
           +
         log (log n) / (42 * 7);

3. Euler-Mascheroni discrete-to-continuous damping

       -gamma / (137 + 1/(8 pi) - x(n));

4. Apery cubic-memory correction

       zeta(3) / (137 * 20).

The resulting projected inverse interaction invariant is

                    1              gamma              zeta(3)
 alpha4^-1 = 137 + ---- - -------------------------- + -------
                   8 pi   137 + 1/(8 pi) - x(n)       137*20

For the Kosmoplex cosmological state count, the associated papers report

    alpha4^-1 approximately 137.035999143.

This module proves the symbolic structure, provenance, dimensional
status, reciprocal uniqueness, and monadic tokenization. It deliberately
does not assert the decimal approximation without a later certified
transcendental enclosure.
-/

namespace PhysicalAlphaProjectionCorrection

/-
## Structural constants already differentiated upstream
-/

/--
The exact eight-dimensional inverse-alpha channel capacity.
-/
noncomputable def baseInverse :
    ℝ :=

  PhysicalAlphaInvariant.alphaInverseMagnitude

/--
The base inverse interaction invariant is exactly 137.
-/
theorem baseInverse_eq_oneThirtySeven :
    baseInverse =
      137 := by

  exact
    PhysicalAlphaInvariant.alphaInverseMagnitude_eq_oneThirtySeven

/--
The canonical glyph count entering the second memory denominator.
-/
def glyphCount :
    ℕ :=
  42

/--
The Fano incidence count entering the second memory denominator.
-/
def fanoCount :
    ℕ :=
  7

/--
The effective cubic-memory denominator factor.

The boundary glyph `21` loses one shared contribution at the
interference point:

    21 - 1 = 20.
-/
def cubicMemoryFactor :
    ℕ :=
  20

theorem glyphCount_eq_fortyTwo :
    glyphCount =
      42 := by

  rfl

theorem fanoCount_eq_seven :
    fanoCount =
      7 := by

  rfl

theorem cubicMemoryFactor_eq_twenty :
    cubicMemoryFactor =
      20 := by

  rfl

/-
## Four-dimensional projection state
-/

/--
A positive cosmological state count used by the Shannon-memory
correction.

The strict inequality `1 < stateCount` ensures that the first logarithm
is positive and that the nested logarithm is defined as an ordinary real
quantity.
-/
structure ProjectionState where

  stateCount :
    ℝ

  stateCount_gt_one :
    1 < stateCount

/--
The state count is positive.
-/
theorem ProjectionState.stateCount_positive
    (state : ProjectionState) :
    0 < state.stateCount := by

  linarith [
    state.stateCount_gt_one
  ]

/--
The logarithm of the state count is positive.
-/
theorem ProjectionState.log_stateCount_positive
    (state : ProjectionState) :
    0 < Real.log state.stateCount := by

  exact
    Real.log_pos
      state.stateCount_gt_one

/-
## Projection corrections
-/

/--
Rotational phase-space correction generated by the octonionic carrier
and circular phase glyph:

    r = 1 / (8 pi).
-/
noncomputable def rotationalCorrection :
    ℝ :=

  1 / (8 * Real.pi)

/--
The rotational correction is positive.
-/
theorem rotationalCorrection_positive :
    0 < rotationalCorrection := by

  unfold rotationalCorrection

  positivity

/--
The Shannon-state memory cost:

    x(n) =
      log n / (2 * 137)
        +
      log(log n) / (42 * 7).
-/
noncomputable def shannonMemoryCost
    (state : ProjectionState) :
    ℝ :=

  Real.log state.stateCount /
      (2 * baseInverse)
    +
  Real.log
      (Real.log state.stateCount) /
      ((glyphCount : ℝ) * fanoCount)

/--
The primary projected denominator before harmonic damping:

    D(n) = 137 + 1/(8 pi) - x(n).
-/
noncomputable def harmonicDenominator
    (state : ProjectionState) :
    ℝ :=

  baseInverse
    +
  rotationalCorrection
    -
  shannonMemoryCost state

/--
Euler-Mascheroni damping at the discrete-to-continuous projection
boundary:

    Delta_gamma(n) = -gamma / D(n).
-/
noncomputable def harmonicDamping
    (state : ProjectionState) :
    ℝ :=

  -
    GlyphSpectralSpecialFunctionOperations.eulerMascheroni
      /
    harmonicDenominator state

/--
The cubic-memory correction:

    Delta_zeta =
      zeta(3) / (137 * 20).
-/
noncomputable def cubicMemoryCorrection :
    ℝ :=

  GlyphSpectralSpecialFunctionOperations.zetaThree
    /
  (baseInverse * cubicMemoryFactor)

/--
The cubic-memory correction is positive.
-/
theorem cubicMemoryCorrection_positive :
    0 < cubicMemoryCorrection := by

  unfold cubicMemoryCorrection

  have hBase :
      0 < baseInverse := by

    unfold baseInverse

    exact
      PhysicalAlphaInvariant.alphaInverseMagnitude_positive

  have hFactor :
      (0 : ℝ) <
        cubicMemoryFactor := by

    norm_num [cubicMemoryFactor]

  exact
    div_pos
      GlyphSpectralSpecialFunctionOperations.zetaThree_positive
      (mul_pos hBase hFactor)

/-
## Corrected inverse interaction invariant
-/

/--
The complete projected inverse-alpha expression.
-/
noncomputable def correctedAlphaInverse
    (state : ProjectionState) :
    ℝ :=

  baseInverse
    +
  rotationalCorrection
    +
  harmonicDamping state
    +
  cubicMemoryCorrection

/--
The complete formula expanded into its four named terms.
-/
theorem correctedAlphaInverse_formula
    (state : ProjectionState) :
    correctedAlphaInverse state =
      baseInverse
        +
      1 / (8 * Real.pi)
        -
      GlyphSpectralSpecialFunctionOperations.eulerMascheroni
        /
      (
        baseInverse
          +
        1 / (8 * Real.pi)
          -
        shannonMemoryCost state
      )
        +
      GlyphSpectralSpecialFunctionOperations.zetaThree
        /
      (
        baseInverse *
          cubicMemoryFactor
      ) := by

  simp [
    correctedAlphaInverse,
    harmonicDamping,
    harmonicDenominator,
    rotationalCorrection,
    cubicMemoryCorrection,
    sub_eq_add_neg,
    div_eq_mul_inv
  ]
/--
The formula with all finite structural counts exposed explicitly.
-/
theorem correctedAlphaInverse_explicit
    (state : ProjectionState) :
    correctedAlphaInverse state =
      137
        +
      1 / (8 * Real.pi)
        -
      GlyphSpectralSpecialFunctionOperations.eulerMascheroni
        /
      (
        137
          +
        1 / (8 * Real.pi)
          -
        (
          Real.log state.stateCount /
              (2 * 137)
            +
          Real.log
              (Real.log state.stateCount) /
              (42 * 7)
        )
      )
        +
      GlyphSpectralSpecialFunctionOperations.zetaThree
        /
      (137 * 20) := by

  simp [
    correctedAlphaInverse,
    harmonicDamping,
    harmonicDenominator,
    shannonMemoryCost,
    rotationalCorrection,
    cubicMemoryCorrection,
    baseInverse_eq_oneThirtySeven,
    glyphCount,
    fanoCount,
    cubicMemoryFactor,
    sub_eq_add_neg,
    div_eq_mul_inv
  ]

/--
The corrected inverse differs from the substrate value by exactly the
sum of the rotational, harmonic, and cubic-memory corrections.
-/
theorem projectionCorrection_decomposition
    (state : ProjectionState) :
    correctedAlphaInverse state -
        baseInverse =
      rotationalCorrection
        +
      harmonicDamping state
        +
      cubicMemoryCorrection := by

  unfold correctedAlphaInverse

  ring

/-
## Corrected alpha invariant
-/

/--
The projected four-dimensional alpha invariant is the reciprocal of its
corrected inverse.
-/
noncomputable def correctedAlpha
    (state : ProjectionState) :
    ℝ :=

  (correctedAlphaInverse state)⁻¹

/--
A positivity certificate for a physically admissible corrected
projection.

The symbolic derivation itself fixes the expression. Positivity may later
be discharged for the canonical cosmological state count by certified
numeric bounds.
-/
def IsAdmissible
    (state : ProjectionState) :
    Prop :=

  0 < correctedAlphaInverse state

/--
An admissible projected alpha invariant is positive.
-/
theorem correctedAlpha_positive
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state) :
    0 < correctedAlpha state := by

  unfold correctedAlpha

  exact
    inv_pos.mpr
      hAdmissible

/--
An admissible corrected inverse is nonzero.
-/
theorem correctedAlphaInverse_ne_zero
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state) :
    correctedAlphaInverse state ≠
      0 := by

  exact
    ne_of_gt
      hAdmissible

/--
The corrected alpha invariant and corrected inverse multiply to one.
-/
theorem correctedAlpha_mul_inverse
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state) :
    correctedAlpha state *
        correctedAlphaInverse state =
      1 := by

  unfold correctedAlpha

  exact
    inv_mul_cancel₀
      (correctedAlphaInverse_ne_zero
        state
        hAdmissible)

/--
The reciprocal of corrected alpha recovers the complete projected
inverse expression.
-/
theorem correctedAlpha_inverse
    (state : ProjectionState) :
    (correctedAlpha state)⁻¹ =
      correctedAlphaInverse state := by

  unfold correctedAlpha

  rw [inv_inv]

/--
The projected alpha invariant is uniquely forced by the corrected inverse
normalization.
-/
theorem correctedAlpha_unique
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state)
    (candidate : ℝ)
    (hCandidate :
      candidate *
          correctedAlphaInverse state =
        1) :
    candidate =
      correctedAlpha state := by

  apply
    mul_right_cancel₀
      (correctedAlphaInverse_ne_zero
        state
        hAdmissible)

  calc
    candidate *
        correctedAlphaInverse state =
      1 :=
        hCandidate

    _ =
      correctedAlpha state *
        correctedAlphaInverse state :=
        (correctedAlpha_mul_inverse
          state
          hAdmissible).symm

/--
There exists exactly one positive projected alpha invariant normalized by
the corrected inverse expression.
-/
theorem existsUnique_correctedAlpha
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state) :
    ∃! interaction : ℝ,
      0 < interaction
        ∧
      interaction *
          correctedAlphaInverse state =
        1 := by

  refine
    ⟨
      correctedAlpha state,
      ?_,
      ?_
    ⟩

  · exact
      ⟨
        correctedAlpha_positive
          state
          hAdmissible,
        correctedAlpha_mul_inverse
          state
          hAdmissible
      ⟩

  · intro candidate hCandidate

    exact
      correctedAlpha_unique
        state
        hAdmissible
        candidate
        hCandidate.2

