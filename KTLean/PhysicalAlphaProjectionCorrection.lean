/-
## Minting the corrected alpha token
-/

/--
Mint the corrected four-dimensional alpha token over one OMBT monad.
-/
noncomputable def correctedAlphaToken
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state)
    (source : KTMonad.Monad) :
    PhysicalTokenInterface.Token :=

  PhysicalTokenInterface.mint
    source
    .interactionStrength
    (correctedAlpha state)
    (correctedAlpha_positive
      state
      hAdmissible)

/--
The corrected alpha token retains its source monad.
-/
@[simp]
theorem correctedAlphaToken_source
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state)
    (source : KTMonad.Monad) :
    (correctedAlphaToken
      state
      hAdmissible
      source).source =
        source := by

  rfl

/--
The corrected alpha token retains the dimensionless interaction role.
-/
@[simp]
theorem correctedAlphaToken_role
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state)
    (source : KTMonad.Monad) :
    (correctedAlphaToken
      state
      hAdmissible
      source).role =
        .interactionStrength := by

  rfl

/--
The corrected alpha token is dimensionless.
-/
theorem correctedAlphaToken_signature
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state)
    (source : KTMonad.Monad) :
    (correctedAlphaToken
      state
      hAdmissible
      source).signature =
        PhysicalTokenInterface.dimensionlessSignature := by

  exact
    PhysicalTokenInterface.alphaToken_is_dimensionless
      (by rfl)

/--
All monads observe the same corrected alpha magnitude for one fixed
projection state.
-/
theorem correctedAlpha_independent_of_monad
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state)
    (left right : KTMonad.Monad) :
    (correctedAlphaToken
      state
      hAdmissible
      left).magnitude =
    (correctedAlphaToken
      state
      hAdmissible
      right).magnitude := by

  rfl

/--
Temporal reversal preserves the corrected alpha invariant.
-/
theorem reverseTemporal_preserves_correctedAlpha
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state)
    (monad : KTMonad.Monad) :
    (
      correctedAlphaToken
        state
        hAdmissible
        (OMBTMonadDynamics.reverseTemporal monad)
    ).magnitude =
      (
        correctedAlphaToken
          state
          hAdmissible
          monad
      ).magnitude := by

  rfl

/--
Visible/escrow exchange preserves the corrected alpha invariant.
-/
theorem exchangePhase_preserves_correctedAlpha
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state)
    (monad : KTMonad.Monad) :
    (
      correctedAlphaToken
        state
        hAdmissible
        (OMBTMonadDynamics.exchangePhase monad)
    ).magnitude =
      (
        correctedAlphaToken
          state
          hAdmissible
          monad
      ).magnitude := by

  rfl

/-
## Capstone
-/

/--
Capstone theorem.

The exact eight-dimensional channel invariant `137` is carried through
the 8D-to-4D projection and corrected by four structural contributions:

* octonionic rotational phase `1/(8 pi)`;
* Shannon-state memory cost `x(n)`;
* Euler-Mascheroni damping;
* Apery cubic-memory recovery.

For every admissible projection state, the resulting corrected inverse
forces one unique positive dimensionless alpha invariant. The corrected
token retains monadic provenance and is invariant under temporal reversal
and visible/escrow exchange.

The theorem proves the exact symbolic KT projection correction. It does
not replace certified transcendental bounds with an asserted decimal.
-/
theorem physical_alpha_projection_correction_emerges
    (state : ProjectionState)
    (hAdmissible : IsAdmissible state) :
    baseInverse =
        137
      ∧
    correctedAlphaInverse state =
      137
        +
      1 / (8 * Real.pi)
        -
      GlyphSpectralSpecialFunctionOperations.eulerMascheroni
        /
      (
        137
          +
        1 / (8 * Real.pi)
          -
        (
          Real.log state.stateCount /
              (2 * 137)
            +
          Real.log
              (Real.log state.stateCount) /
              (42 * 7)
        )
      )
        +
      GlyphSpectralSpecialFunctionOperations.zetaThree
        /
      (137 * 20)
      ∧
    (
      ∃! interaction : ℝ,
        0 < interaction
          ∧
        interaction *
            correctedAlphaInverse state =
          1
    )
      ∧
    (
      ∀ source : KTMonad.Monad,
        (correctedAlphaToken
          state
          hAdmissible
          source).source =
            source
          ∧
        (correctedAlphaToken
          state
          hAdmissible
          source).role =
            .interactionStrength
          ∧
        (correctedAlphaToken
          state
          hAdmissible
          source).signature =
            PhysicalTokenInterface.dimensionlessSignature
          ∧
        0 <
          (correctedAlphaToken
            state
            hAdmissible
            source).magnitude
    )
      ∧
        (
      GlyphSpectrum.values[5]? =
          some
            (.natural 8)
        ∧
      GlyphSpectrum.values[11]? =
          some
            .circleConstant
        ∧
      GlyphSpectrum.values[31]? =
          some
            .eulerMascheroni
        ∧
      GlyphSpectrum.values[35]? =
          some
            (.zeta 3)
        ∧
      GlyphSpectrum.values[41]? =
          some
            (.natural 137)
    ) := by

  refine
    ⟨
      baseInverse_eq_oneThirtySeven,
      correctedAlphaInverse_explicit state,
      existsUnique_correctedAlpha
        state
        hAdmissible,
      ?_,
      correction_constants_preexist
    ⟩

  intro source

  exact
    ⟨
      correctedAlphaToken_source
        state
        hAdmissible
        source,
      correctedAlphaToken_role
        state
        hAdmissible
        source,
      correctedAlphaToken_signature
        state
        hAdmissible
        source,
      (
        correctedAlphaToken
          state
          hAdmissible
          source
      ).magnitude_positive
    ⟩

end PhysicalAlphaProjectionCorrection

